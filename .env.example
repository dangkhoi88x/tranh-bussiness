# Copy to .env for local development. Never commit the real .env file.
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/art_store
DB_USERNAME=art_store
DB_PASSWORD=replace-with-local-db-password
POSTGRES_DB=art_store
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-base64-secret-at-least-32-bytes-long
REDIS_HOST=localhost
REDIS_PORT=6379
FRONTEND_URL=http://localhost:5173
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@tranh.local
APP_SEED_ENABLED=true
APP_SEED_ADMIN_EMAIL=admin@tranh.local
APP_SEED_ADMIN_PASSWORD=change-this-local-admin-password
MEDIA_MAX_IMAGE_SIZE_BYTES=10485760
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
