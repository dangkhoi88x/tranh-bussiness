SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/art_store
DB_USERNAME=art_store
DB_PASSWORD=change_me
POSTGRES_DB=art_store
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=replace_with_a_base64_secret_at_least_32_bytes_long
REDIS_HOST=localhost
REDIS_PORT=6379
FRONTEND_URL=http://localhost:5173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
APP_SEED_ENABLED=true
APP_SEED_ADMIN_EMAIL=admin@tranh.local
APP_SEED_ADMIN_PASSWORD=
# Quản trị viên đầu tiên cho môi trường không chạy seed (prod/staging). Bỏ trống email là tắt.
# Mật khẩu 12-72 ký tự; tài khoản đã tồn tại sẽ chỉ được cấp role ADMIN, không bị đổi mật khẩu.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
# Chỉ bật khi cần đặt lại mật khẩu admin bị quên, restart một lần rồi tắt lại.
BOOTSTRAP_ADMIN_RESET_PASSWORD=false
# Hạn mức theo IP cho endpoint xác thực, đếm trên Redis. Xem README để biết mặc định.
AUTH_RATE_LIMIT_ENABLED=true
MEDIA_MAX_IMAGE_SIZE_BYTES=10485760
# Bản mềm photobook là PDF nhiều spread nên cần trần riêng, rộng hơn (50MB).
MEDIA_MAX_PROOF_SIZE_BYTES=52428800
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
