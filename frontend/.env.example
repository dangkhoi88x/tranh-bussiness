# Spring Boot API. Keep localhost (not 127.0.0.1) to match the default CORS setting.
VITE_API_BASE=http://localhost:8080/api/v1
# Public storefront origin used for canonical and Open Graph URLs in production.
# Example: https://shop.example.com
VITE_SITE_URL=

# Required by `npm run seo:prerender` in the production build pipeline.
# The script fetches published catalogue data and writes static HTML for products/categories,
# sitemap.xml and robots.txt into dist/ so social crawlers receive metadata before React runs.
SEO_API_BASE=
SEO_SITE_URL=
